<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by `make install`; @...@ placeholders are replaced with absolute paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cc-sessions.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>@DAEMON_PYTHON@</string>
    <string>@DAEMON_SCRIPT@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/cc-sessions.daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/cc-sessions.daemon.out.log</string>
</dict>
</plist>
